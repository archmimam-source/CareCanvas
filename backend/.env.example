# Copy to backend/.env for local development. On Render these are set in the dashboard.

# MongoDB (local: mongodb://localhost:27017 · production: your MongoDB Atlas connection string)
MONGO_URL=mongodb://localhost:27017
DB_NAME=carecanvas

# Long random strings. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
SIGNING_SECRET=change-me

# Comma-separated list of allowed frontend origins (use * only for local dev)
CORS_ORIGINS=http://localhost:3000

# Admin account created on first start
ADMIN_EMAIL=admin@his.dev
ADMIN_PASSWORD=change-me

# Comma-separated emails allowed to approve publishing
PUBLISH_APPROVER_EMAILS=

# Gemini API key from https://aistudio.google.com/apikey (powers all AI features)
GEMINI_API_KEY=

# Where uploads and AI renders are stored (default: <repo>/uploads)
# DATA_DIR=/var/data
